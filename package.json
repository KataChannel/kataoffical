{
  "dependencies": {
    "axios": "^1.12.2",
    "class-validator": "^0.14.1"
  },
  "scripts": {
    "dev": "./bun-dev.sh",
    "dev:api": "cd api && bun run start:dev",
    "dev:frontend": "cd frontend && npm run start",
    "dev:full": "./bun-dev.sh --full",
    "dev:fresh": "./bun-dev.sh --fresh",
    "install:api": "cd api && bun install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "cd api && bun install && cd ../frontend && npm install",
    "prisma:generate": "cd api && bun prisma generate",
    "prisma:push": "cd api && bun prisma db push",
    "prisma:studio": "cd api && bun prisma studio",
    "build": "cd api && bun run build && cd ../frontend && npm run build",
    "build:api": "cd api && bun run build",
    "build:frontend": "cd frontend && npm run build",
    "deploy": "./quick-deploy.sh all",
    "deploy:api": "./quick-deploy.sh backend",
    "deploy:frontend": "./quick-deploy.sh frontend",
    "menu": "./menu.sh",
    "autorun": "./autorun.sh",
    "db:backup": "cd api && npx ts-node prisma/backup.ts",
    "db:restore": "cd api && npx ts-node prisma/restore.ts",
    "db:restore:audit": "cd api && npx ts-node prisma/restore.ts --fix-audit-log",
    "db:update": "cd api && npx ts-node prisma/update.ts",
    "db:updatevat": "cd api && npx ts-node prisma/updatevat.ts",
    "db:updatevatsanpham": "cd api && npx ts-node prisma/updatevatsanpham.ts",
    "db:updatebanggiadonhang": "cd api && npx ts-node prisma/updatebanggiadonhang.ts",
    "db:updatetonkho": "cd api && npx ts-node prisma/updatetonkho.ts",
    "db:updateoffvat": "cd api && npx ts-node prisma/updateoffvat.ts",
    "db:updatekhachhang": "cd api && npx ts-node prisma/updatekhachhang.ts",
    "db:seed": "cd api && npx ts-node prisma/seed.ts",
    "db:delete-audit": "cd api && npx ts-node scripts/delete-audit-before-date.ts",
    "db:updatedongbosanphamtonkho": "cd api && npx ts-node prisma/updatedongbosanphamtonkho.ts",
    "db:generate": "cd api && npx prisma generate",
    "db:migrate": "cd api && bun prisma migrate dev --name tenfile",
    "db:reset": "cd api && bun prisma migrate reset",
    "db:push": "cd api && bun prisma db push",
    "db:studio": "cd api && bun prisma studio"
  },
  "devDependencies": {
    "xlsx": "^0.18.5"
  }
}
