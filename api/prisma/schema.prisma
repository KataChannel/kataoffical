generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource postgres {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id            String      @id
  entityName    String?
  entityId      String?
  action        AuditAction
  userId        String?
  userEmail     String?
  oldValues     Json?
  newValues     Json?
  changedFields String[]
  ipAddress     String?
  userAgent     String?
  sessionId     String?
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  status        String      @default("SUCCESS")
  error_details Json?
  User          User?       @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@index([entityName, entityId])
  @@index([status])
  @@index([userId])
}

model Banggia {
  id             String           @id
  title          String?
  mabanggia      String?
  type           String?
  batdau         DateTime?
  ketthuc        DateTime?
  order          Int?             @default(1)
  ghichu         String?
  status         String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  isDefault      Boolean          @default(false)
  Banggiasanpham Banggiasanpham[]
  Donhang        Donhang[]
  Khachhang      Khachhang[]

  @@unique([mabanggia, batdau, ketthuc])
  @@index([batdau, ketthuc])
  @@index([mabanggia])
}

model Banggiasanpham {
  id                    String                  @id
  giaban                Decimal                 @default(0) @postgres.Decimal(20, 3)
  sanphamId             String
  banggiaId             String
  order                 Int?
  isActive              Boolean                 @default(false)
  Banggia               Banggia                 @relation(fields: [banggiaId], references: [id])
  Sanpham               Sanpham                 @relation(fields: [sanphamId], references: [id])
  BanggiasanphamHistory BanggiasanphamHistory[]

  @@unique([banggiaId, sanphamId])
}

model BanggiasanphamHistory {
  id               String         @id
  banggiasanphamId String
  banggiaId        String
  sanphamId        String
  oldPrice         Decimal        @postgres.Decimal(20, 3)
  newPrice         Decimal        @postgres.Decimal(20, 3)
  changePercent    Decimal?       @postgres.Decimal(10, 2)
  changeReason     String?
  changedBy        String?
  changedAt        DateTime       @default(now())
  sourceType       String?
  batchId          String?
  metadata         Json?
  Banggiasanpham   Banggiasanpham @relation(fields: [banggiasanphamId], references: [id], onDelete: Cascade)

  @@index([banggiaId])
  @@index([banggiasanphamId])
  @@index([changedAt])
  @@index([sanphamId])
}

model ChatAIHistory {
  id        String   @id
  userId    String
  message   String
  sender    String
  createdAt DateTime @default(now())
}

model ChatAIMessage {
  id        String   @id
  userId    String
  message   String
  reply     String
  createdAt DateTime @default(now())
}

model Chotkho {
  id            String          @id
  khoId         String?
  ghichu        String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  codeId        String?         @unique
  title         String?
  order         Int?            @default(1)
  userId        String?
  ngaychot      DateTime        @default(now())
  Kho           Kho?            @relation(fields: [khoId], references: [id])
  User          User?           @relation(fields: [userId], references: [id])
  Chotkhodetail Chotkhodetail[]

  @@index([codeId])
  @@index([khoId])
  @@index([ngaychot])
}

model Chotkhodetail {
  id           String   @id
  title        String?
  ngaychot     DateTime @default(now())
  sltonhethong Decimal  @default(0) @postgres.Decimal(20, 3)
  sltonthucte  Decimal  @default(0) @postgres.Decimal(20, 3)
  slhuy        Decimal  @default(0) @postgres.Decimal(20, 3)
  chenhlech    Decimal  @default(0) @postgres.Decimal(20, 3)
  ghichu       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  order        Int?     @default(1)
  sanphamId    String?
  chotkhoId    String?
  userId       String?
  Chotkho      Chotkho? @relation(fields: [chotkhoId], references: [id])
  Sanpham      Sanpham? @relation(fields: [sanphamId], references: [id])
  User         User?    @relation(fields: [userId], references: [id])

  @@index([ngaychot])
  @@index([sanphamId])
}

model Congty {
  id        String   @id
  name      String
  diachi    String?
  email     String?
  sdt       String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
  Kho       Kho[]
}

// ============================================
// CRON JOB EXECUTION LOG
// ============================================
model CronExecutionLog {
  id            String        @id @default(uuid())
  jobId         String // ID của cron job (database-sync, auto-complete-orders, etc.)
  jobName       String // Tên hiển thị của job
  category      String? // Phân loại: Database, Đơn hàng, System
  startTime     DateTime      @default(now())
  endTime       DateTime?
  status        CronJobStatus @default(running)
  message       String? // Thông báo kết quả
  error         String? // Chi tiết lỗi nếu có
  details       Json? // Chi tiết bổ sung (databaseSize, tableStats, etc.)
  executionTime Int? // Thời gian thực thi (ms)
  triggeredBy   String? // Ai kích hoạt: system, manual, userId
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([startTime])
  @@index([createdAt])
}

model Dathang {
  id             String           @id
  title          String?
  type           String?
  madncc         String?          @unique
  ngaynhan       DateTime?
  ghichu         String?
  nhacungcapId   String?
  order          Int?
  isActive       Boolean          @default(false)
  status         StatusDonhang    @default(dadat)
  printCount     Int?             @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime?
  subtitle       String?
  khoId          String?
  lydohuy        String?
  Kho            Kho?             @relation(fields: [khoId], references: [id])
  Nhacungcap     Nhacungcap?      @relation(fields: [nhacungcapId], references: [id])
  Dathangsanpham Dathangsanpham[]
  PhieuKho       PhieuKho[]

  @@index([createdAt])
  @@index([ngaynhan])
  @@index([ngaynhan, status])
  @@index([nhacungcapId])
  @@index([nhacungcapId, ngaynhan])
  @@index([status])
}

model Dathangsanpham {
  id        String  @id
  idSP      String
  sldat     Decimal @default(0) @postgres.Decimal(20, 3)
  slgiao    Decimal @default(0) @postgres.Decimal(20, 3)
  slnhan    Decimal @default(0) @postgres.Decimal(20, 3)
  slhuy     Decimal @default(0) @postgres.Decimal(20, 3)
  ttdat     Decimal @default(0) @postgres.Decimal(20, 3)
  ttgiao    Decimal @default(0) @postgres.Decimal(20, 3)
  ttnhan    Decimal @default(0) @postgres.Decimal(20, 3)
  ghichu    String?
  dathangId String
  order     Int?
  isActive  Boolean @default(false)
  gianhap   Decimal @default(0) @postgres.Decimal(20, 3)
  Dathang   Dathang @relation(fields: [dathangId], references: [id], onDelete: Cascade)
  Sanpham   Sanpham @relation(fields: [idSP], references: [id])

  @@index([dathangId])
  @@index([idSP])
}

model Donhang {
  id               String           @id
  title            String?
  type             String?
  madonhang        String           @unique
  ngaygiao         DateTime?
  ghichu           String?
  status           StatusDonhang    @default(dadat)
  khachhangId      String?
  printCount       Int?             @default(0)
  order            Int?
  isActive         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  isshowvat        Boolean          @default(false)
  tongtien         Decimal          @default(0) @postgres.Decimal(20, 3)
  tongvat          Decimal          @default(0) @postgres.Decimal(20, 3)
  banggiaId        String?
  vat              Decimal          @default(0.5) @postgres.Decimal(20, 3)
  lydohuy          String?
  giodi            String?
  giove            String?
  kynhan           String?
  phieuve          String?
  nhanvienchiahang String?
  shipper          String?
  confirmToken     String?          @unique
  ghiChuKH         String?
  tokenExpiredAt   DateTime?
  xacNhanLan1      Boolean?         @default(false)
  xacNhanLan1At    DateTime?
  xacNhanLan2      Boolean?         @default(false)
  xacNhanLan2At    DateTime?
  xuatHoaDon       Boolean?         @default(false)
  Banggia          Banggia?         @relation(fields: [banggiaId], references: [id])
  Khachhang        Khachhang?       @relation(fields: [khachhangId], references: [id])
  Donhangsanpham   Donhangsanpham[]
  HoaDonDienTu     HoaDonDienTu[]
  PhieuKho         PhieuKho[]
  PhieuThuChi      PhieuThuChi[]
  ThanhToan        ThanhToan[]

  @@index([confirmToken])
  @@index([createdAt])
  @@index([khachhangId])
  @@index([khachhangId, ngaygiao])
  @@index([ngaygiao])
  @@index([ngaygiao, status])
  @@index([status])
}

model DonhangPriceAudit {
  id               String   @id
  donhangId        String
  donhangsanphamId String
  sanphamId        String
  oldPrice         Decimal  @postgres.Decimal(20, 3)
  newPrice         Decimal  @postgres.Decimal(20, 3)
  changePercent    Decimal? @postgres.Decimal(10, 2)
  changeReason     String
  changedBy        String?
  changedByEmail   String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())
  metadata         Json?

  @@index([createdAt])
  @@index([donhangId])
  @@index([donhangsanphamId])
  @@index([sanphamId])
}

model Donhangsanpham {
  id        String   @id
  idSP      String
  sldat     Decimal  @default(0) @postgres.Decimal(20, 3)
  slgiao    Decimal  @default(0) @postgres.Decimal(20, 3)
  slnhan    Decimal  @default(0) @postgres.Decimal(20, 3)
  slhuy     Decimal  @default(0) @postgres.Decimal(20, 3)
  ttdat     Decimal  @default(0) @postgres.Decimal(20, 3)
  ttgiao    Decimal  @default(0) @postgres.Decimal(20, 3)
  ttnhan    Decimal  @default(0) @postgres.Decimal(20, 3)
  ghichu    String?
  donhangId String
  order     Int?
  isActive  Boolean? @default(false)
  giaban    Decimal  @default(0) @postgres.Decimal(20, 3)
  ttsauvat  Decimal  @default(0) @postgres.Decimal(20, 3)
  vat       Decimal  @default(0) @postgres.Decimal(20, 3)
  Donhang   Donhang  @relation(fields: [donhangId], references: [id], onDelete: Cascade)
  Sanpham   Sanpham  @relation(fields: [idSP], references: [id])

  @@index([donhangId])
  @@index([idSP])
}

model ErrorLog {
  id        String   @id
  timestamp DateTime
  message   String
  details   Json?
  source    String
  createdAt DateTime @default(now())
}

model File {
  id        String   @id
  fileName  String?
  fileUrl   String?
  jsonData  Json?
  createdAt DateTime @default(now())
}

model FileManager {
  id          String   @id
  codeId      String?  @unique
  title       String?
  url         String?
  description String?
  fileType    String?
  fileSize    Int?
  metaData    Json?
  category    String?
  group       String?
  order       Int?     @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model HoaDonDienTu {
  id            String          @id
  donhangId     String
  soHoaDon      String          @unique
  mauSo         String?
  kyHieu        String?
  ngayLap       DateTime        @default(now())
  tongTien      Decimal         @postgres.Decimal(20, 3)
  tongVAT       Decimal         @default(0) @postgres.Decimal(20, 3)
  tongThanhToan Decimal         @postgres.Decimal(20, 3)
  trangThai     TrangThaiHoaDon @default(NHAP)
  pdfUrl        String?
  nguoiTaoId    String?
  nguoiDuyetId  String?
  ngayDuyet     DateTime?
  ghichu        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  Donhang       Donhang         @relation(fields: [donhangId], references: [id], onDelete: Cascade)

  @@index([donhangId])
  @@index([ngayLap])
  @@index([soHoaDon])
  @@index([trangThai])
}

model ImportHistory {
  id         String   @id
  caseDetail Json?
  importTime DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  codeId     String?  @unique
  order      Int?     @default(1)
  createdBy  String?  @default("system")
  status     String?
  title      String?
  type       String?
}

model Khachhang {
  id            String          @id
  name          String?
  namenn        String?
  subtitle      String?
  makh          String          @unique
  makhold       String?
  diachi        String?
  sdt           String?
  mst           String?
  gionhanhang   String?
  quan          String?
  email         String?
  phone         String?
  address       String?
  loaikh        String?
  ghichu        String?
  hiengia       Boolean         @default(false)
  isActive      Boolean         @default(false)
  istitle2      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  tenfile       String?
  tenkh         String?
  banggiaId     String?
  isshowvat     Boolean         @default(true)
  machuyen      String?
  Donhang       Donhang[]
  Banggia       Banggia?        @relation(fields: [banggiaId], references: [id])
  Nhomkhachhang Nhomkhachhang[] @relation("KhachhangNhom")

  @@index([name])
}

model Kho {
  id         String       @id
  name       String
  makho      String?
  diachi     String?
  sdt        String?
  ghichu     String?
  congtyId   String?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  Chotkho    Chotkho[]
  Dathang    Dathang[]
  Congty     Congty?      @relation(fields: [congtyId], references: [id])
  PhieuKho   PhieuKho[]
  SanphamKho SanphamKho[]
}

model Menu {
  id         String   @id
  title      String
  icon       String?
  slug       String?
  parentId   String?
  order      Int?
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Menu       Menu?    @relation("MenuToMenu", fields: [parentId], references: [id])
  other_Menu Menu[]   @relation("MenuToMenu")
}

model Nhacungcap {
  id        String    @id
  name      String?
  mancc     String    @unique
  manccold  String?
  diachi    String?
  email     String?
  sdt       String?
  ghichu    String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime
  isshowvat Boolean   @default(true)
  tenfile   String?
  Dathang   Dathang[]
  NhomNcc   NhomNcc[] @relation("NhacungcapNhom")
  Sanpham   Sanpham[]
}

model Nhanvien {
  id                                        String            @id
  isActive                                  Boolean           @default(true)
  createdAt                                 DateTime          @default(now())
  updatedAt                                 DateTime
  avatar                                    String?
  chiNhanh                                  String?
  chucVu                                    String?
  cmnd                                      String?           @unique
  diaChiHienTai                             String?
  diaChiTamTru                              String?
  diaChiThuongTru                           String?
  email                                     String?           @unique
  ghiChu                                    String?
  gioiTinh                                  GioiTinh?         @default(KHAC)
  heSoLuong                                 Decimal?          @default(1) @postgres.Decimal(10, 2)
  hoTen                                     String
  hoTenDem                                  String?
  loaiHopDong                               String?
  luongCoBan                                Decimal?          @default(0) @postgres.Decimal(20, 3)
  maNV                                      String            @unique
  nganHang                                  String?
  ngayCapCmnd                               DateTime?
  ngayNghiViec                              DateTime?
  ngaySinh                                  DateTime?
  ngayVaoLam                                DateTime?
  nguoiLienHeKhanCap                        String?
  noiCapCmnd                                String?
  order                                     Int?              @default(1)
  phongbanId                                String?
  phuCap                                    Decimal?          @default(0) @postgres.Decimal(20, 3)
  quanHeKhanCap                             String?
  sdtKhanCap                                String?
  soDienThoai                               String?
  soTaiKhoan                                String?
  ten                                       String?
  trangThai                                 TrangThaiNhanvien @default(DANGLAMVIEC)
  userId                                    String?           @unique
  viTri                                     String?
  maLamViec                                 String?           @unique
  hieuSuatCongViec                          Decimal?          @default(0) @postgres.Decimal(20, 3)
  hoTroChuyenCan                            Decimal?          @default(0) @postgres.Decimal(20, 3)
  phuCapDienThoai                           Decimal?          @default(0) @postgres.Decimal(20, 3)
  phuCapKhac                                Decimal?          @default(0) @postgres.Decimal(20, 3)
  phuCapXang                                Decimal?          @default(0) @postgres.Decimal(20, 3)
  thuongKinhDoanh                           Decimal?          @default(0) @postgres.Decimal(20, 3)
  tienAnGiuaCa                              Decimal?          @default(0) @postgres.Decimal(20, 3)
  Phongban_Nhanvien_phongbanIdToPhongban    Phongban?         @relation("Nhanvien_phongbanIdToPhongban", fields: [phongbanId], references: [id])
  User                                      User?             @relation(fields: [userId], references: [id])
  Phongban_Phongban_truongPhongIdToNhanvien Phongban[]        @relation("Phongban_truongPhongIdToNhanvien")

  @@index([email])
  @@index([hoTen])
  @@index([maNV])
  @@index([phongbanId])
  @@index([trangThai])
  @@index([userId])
}

model NhomNcc {
  id          String       @id
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  Nhacungcap  Nhacungcap[] @relation("NhacungcapNhom")
}

model Nhomkhachhang {
  id          String      @id
  name        String      @unique
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  Khachhang   Khachhang[] @relation("KhachhangNhom")
}

model Permission {
  id             String           @id
  codeId         String?
  name           String           @unique
  group          String?
  description    String?
  order          Int?             @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  RolePermission RolePermission[]
  UserPermission UserPermission[]
}

model PhieuKho {
  id              String            @id
  title           String?
  maphieu         String?           @unique
  madonhang       String?
  madncc          String?
  madathang       String?
  ngay            DateTime?
  type            String?
  khoId           String?
  ghichu          String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  isChotkho       Boolean           @default(false)
  Kho             Kho?              @relation(fields: [khoId], references: [id])
  Dathang         Dathang?          @relation(fields: [madncc], references: [madncc])
  Donhang         Donhang?          @relation(fields: [madonhang], references: [madonhang])
  PhieuKhoSanpham PhieuKhoSanpham[]
}

model PhieuKhoSanpham {
  id         String   @id
  phieuKhoId String
  sanphamId  String
  soluong    Decimal  @default(0) @postgres.Decimal(20, 3)
  ghichu     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  PhieuKho   PhieuKho @relation(fields: [phieuKhoId], references: [id])
  Sanpham    Sanpham  @relation(fields: [sanphamId], references: [id])

  @@unique([phieuKhoId, sanphamId])
}

model PhieuThuChi {
  id           String              @id
  maPhieu      String              @unique
  loai         LoaiPhieuThuChi
  ngay         DateTime            @default(now())
  soTien       Decimal             @postgres.Decimal(20, 3)
  donhangId    String?
  dathangId    String?
  doiTuong     DoiTuongThuChi
  doiTuongId   String?
  tenDoiTuong  String?
  phuongThuc   PhuongThucThanhToan @default(TIEN_MAT)
  coHoaDon     Boolean             @default(false)
  trangThai    TrangThaiPhieu      @default(NHAP)
  nguoiTaoId   String?
  nguoiDuyetId String?
  ngayDuyet    DateTime?
  ghichu       String?
  lydo         String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime
  Donhang      Donhang?            @relation(fields: [donhangId], references: [id])

  @@index([doiTuong, doiTuongId])
  @@index([donhangId])
  @@index([loai])
  @@index([maPhieu])
  @@index([ngay])
  @@index([trangThai])
}

model Phongban {
  id                                        String       @id
  ma                                        String       @unique
  ten                                       String
  loai                                      LoaiPhongban @default(PHONGBAN)
  level                                     Int          @default(1)
  moTa                                      String?
  dienThoai                                 String?
  email                                     String?
  diaChi                                    String?
  truongPhongId                             String?
  parentId                                  String?
  order                                     Int?         @default(1)
  isActive                                  Boolean      @default(true)
  createdAt                                 DateTime     @default(now())
  updatedAt                                 DateTime
  Nhanvien_Nhanvien_phongbanIdToPhongban    Nhanvien[]   @relation("Nhanvien_phongbanIdToPhongban")
  Phongban                                  Phongban?    @relation("PhongbanToPhongban", fields: [parentId], references: [id])
  other_Phongban                            Phongban[]   @relation("PhongbanToPhongban")
  Nhanvien_Phongban_truongPhongIdToNhanvien Nhanvien?    @relation("Phongban_truongPhongIdToNhanvien", fields: [truongPhongId], references: [id])

  @@index([level])
  @@index([ma])
  @@index([parentId])
  @@index([truongPhongId])
}

model Profile {
  id     String  @id
  userId String  @unique
  name   String
  avatar String?
  bio    String?
  User   User    @relation(fields: [userId], references: [id])
}

model Role {
  id             String           @id
  name           String           @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  RolePermission RolePermission[]
  UserRole       UserRole[]
}

model RolePermission {
  id           String     @id
  roleId       String
  permissionId String
  Permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  Role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model Sanpham {
  id              String            @id
  title           String
  title2          String?
  slug            String?           @unique
  masp            String            @unique
  subtitle        String?
  giagoc          Decimal           @default(0) @postgres.Decimal(20, 3)
  dvt             String?
  hinhanh         String?
  loadpoint       Decimal?          @default(0) @postgres.Decimal(20, 3)
  soluong         Decimal?          @default(0) @postgres.Decimal(20, 3)
  soluongkho      Decimal?          @default(0) @postgres.Decimal(20, 3)
  haohut          Decimal           @default(0) @postgres.Decimal(20, 3)
  ghichu          String?
  order           Int?              @default(1)
  isActive        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  giaban          Decimal           @default(0) @postgres.Decimal(20, 3)
  vat             Decimal?          @default(0) @postgres.Decimal(20, 3)
  Banggiasanpham  Banggiasanpham[]
  Chotkhodetail   Chotkhodetail[]
  Dathangsanpham  Dathangsanpham[]
  Donhangsanpham  Donhangsanpham[]
  PhieuKhoSanpham PhieuKhoSanpham[]
  SanphamKho      SanphamKho[]
  TonKho          TonKho?
  Nhacungcap      Nhacungcap[]
}

model SanphamKho {
  id        String   @id
  khoId     String
  sanphamId String
  soluong   Decimal  @default(0) @postgres.Decimal(20, 3)
  ghichu    String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  Kho       Kho      @relation(fields: [khoId], references: [id])
  Sanpham   Sanpham  @relation(fields: [sanphamId], references: [id])
}

model ThanhToan {
  id            String              @id
  maThanhToan   String              @unique
  donhangId     String
  soTien        Decimal             @postgres.Decimal(20, 3)
  loai          LoaiThanhToan       @default(KHONG_HOA_DON)
  phuongThuc    PhuongThucThanhToan @default(TIEN_MAT)
  ngayThanhToan DateTime            @default(now())
  trangThai     TrangThaiThanhToan  @default(DA_THANH_TOAN)
  nguoiTaoId    String?
  ghichu        String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime
  Donhang       Donhang             @relation(fields: [donhangId], references: [id], onDelete: Cascade)

  @@index([donhangId])
  @@index([maThanhToan])
  @@index([ngayThanhToan])
  @@index([trangThai])
}

model TonKho {
  id        String  @id
  sanphamId String  @unique
  slton     Decimal @default(0) @postgres.Decimal(20, 3)
  slchogiao Decimal @default(0) @postgres.Decimal(20, 3)
  slchonhap Decimal @default(0) @postgres.Decimal(20, 3)
  sltontt   Decimal @default(0) @postgres.Decimal(20, 3)
  Sanpham   Sanpham @relation(fields: [sanphamId], references: [id])
}

model User {
  id                                                 String              @id
  email                                              String?             @unique
  SDT                                                String?             @unique
  password                                           String
  provider                                           String?
  providerId                                         String?             @unique
  isActive                                           Boolean             @default(false)
  createdAt                                          DateTime            @default(now())
  updatedAt                                          DateTime
  name                                               String?
  AuditLog                                           AuditLog[]
  Chotkho                                            Chotkho[]
  Chotkhodetail                                      Chotkhodetail[]
  Nhanvien                                           Nhanvien?
  Profile                                            Profile?
  UserPermission                                     UserPermission[]
  UserRole                                           UserRole[]
  support_responses                                  support_responses[]
  support_tickets_support_tickets_createdByToUser    support_tickets[]   @relation("support_tickets_createdByToUser")
  support_tickets_support_tickets_technicianIdToUser support_tickets[]   @relation("support_tickets_technicianIdToUser")
}

model UserPermission {
  id           String     @id
  userId       String
  permissionId String
  isGranted    Boolean    @default(true)
  grantedBy    String?
  grantedAt    DateTime   @default(now())
  expiresAt    DateTime?
  reason       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  User         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([permissionId])
  @@index([userId])
}

model UserRole {
  id     String @id
  userId String
  roleId String
  Role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserguidBlock {
  id           String        @id
  codeId       String?       @unique
  type         String
  title        String?
  description  String?
  listItems    String?
  imageUrl     String?
  imageAlt     String?
  videoUrl     String?
  videoType    String?
  stepId       String?
  order        Int?          @default(1)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  UserguidStep UserguidStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)
}

model UserguidStep {
  id            String          @id
  codeId        String?         @unique
  time          String?
  title         String?
  description   String?
  order         Int?            @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  UserguidBlock UserguidBlock[]

  @@index([id])
}

model performance_logs {
  id          String   @id
  name        String
  duration    Float
  timestamp   DateTime @default(now())
  context     Json?
  success     Boolean  @default(true)
  error       String?
  method      String?
  url         String?
  statusCode  Int?
  memoryUsage Float?

  @@index([duration])
  @@index([name])
  @@index([success])
  @@index([timestamp])
}

model support_attachments {
  id                String             @id
  fileUrl           String
  fileName          String
  fileType          String
  fileSize          Int                @default(0)
  createdAt         DateTime           @default(now())
  ticketId          String?
  responseId        String?
  support_responses support_responses? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  support_tickets   support_tickets?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([ticketId])
}

model support_responses {
  id                  String                @id
  content             String
  createdAt           DateTime              @default(now())
  createdBy           String
  ticketId            String
  support_attachments support_attachments[]
  User                User                  @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  support_tickets     support_tickets       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([createdBy])
  @@index([ticketId])
}

model support_tickets {
  id                                      String                @id
  title                                   String
  description                             String
  status                                  TicketStatus          @default(open)
  priority                                TicketPriority        @default(medium)
  category                                String?
  createdAt                               DateTime              @default(now())
  updatedAt                               DateTime
  createdBy                               String
  technicianId                            String?
  support_attachments                     support_attachments[]
  support_responses                       support_responses[]
  User_support_tickets_createdByToUser    User                  @relation("support_tickets_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  User_support_tickets_technicianIdToUser User?                 @relation("support_tickets_technicianIdToUser", fields: [technicianId], references: [id])

  @@index([createdBy])
  @@index([status])
  @@index([technicianId])
}

