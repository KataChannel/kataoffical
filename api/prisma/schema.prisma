  NGHIPHEP
  THUVIEC
  DANGHIVIEC
  TAMNGHI
  KHAC
}

enum LoaiPhieuThuChi {
  THU
  CHI
}

enum DoiTuongThuChi {
  KHACHHANG
  NHACUNGCAP
  NHANVIEN
  KHAC
}

enum PhuongThucThanhToan {
  TIEN_MAT
  CHUYEN_KHOAN
  THE
  VI_DIEN_TU
}

enum TrangThaiPhieu {
  NHAP
  CHO_DUYET
  DA_DUYET
  HUY
  DA_THANH_TOAN
}

enum LoaiThanhToan {
  CO_HOA_DON
  KHONG_HOA_DON
  TONG_HOP
}

enum TrangThaiThanhToan {
  CHO_THANH_TOAN
  DA_THANH_TOAN
  HUY
}

enum TrangThaiHoaDon {
  NHAP
  DA_XUAT
  HUY
}

enum POStatus {
