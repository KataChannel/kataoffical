{
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/**": true,
    "**/dist/**": true,
    "**/rausach_json/**": true,
    "**/.angular/**": true,
    "**/uploads/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/rausach_json": true,
    "**/.angular": true,
    "**/uploads": true,
    "**/*.bak": true,
    "**/*copy*.ts": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": false,
    "**/*.bak": true
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.preferences.importModuleSpecifier": "relative",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  }
}
